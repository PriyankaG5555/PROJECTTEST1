# Copy to backend/.env for local development. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://gy:gy_dev_password@localhost:5432/ghumakkadyatri
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ENVIRONMENT=development
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Optional: Google Places (suggestions + AI place data)
GOOGLE_PLACES_API_KEY=
# Optional: AI day planning (specs/ai-feature.md). Leave AI_LLM_PROVIDER empty to disable.
AI_LLM_PROVIDER=
AI_LLM_API_KEY=
AI_LLM_MODEL=claude-opus-5-5
AI_PLAN_DAILY_LIMIT=10
